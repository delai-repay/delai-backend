# Core backend
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Use a long, randomly generated value shared only with the Render cron job.
CRON_SECRET=
CRON_TIMEOUT_MS=30000
CRON_JOB_LIMIT=20
AUTOMATION_JOB_LEASE_SECONDS=300

# 32 random bytes encoded as 64 hexadecimal characters or base64.
PAYMENT_DATA_ENCRYPTION_KEY=

# GoCardless: start with sandbox and keep collection locked until verified.
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_RETRY_IF_POSSIBLE=false
PAYMENTS_FEE_COLLECTION_ENABLED=false
PAYMENTS_LIVE_COLLECTION_ENABLED=false
FEE_COLLECTION_AUTOMATIC_RETRY_ENABLED=false

# Accumulated 10% success-fee policy: £5 threshold and annual residual.
PAYMENTS_FEE_COLLECTION_THRESHOLD_PENCE=500
PAYMENTS_ANNUAL_RESIDUAL_DAYS=365
PAYMENTS_MIN_ANNUAL_COLLECTION_PENCE=100

# In-process HTTP rate limits (per Render instance and source IP).
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
CLAIM_RATE_LIMIT_MAX=120
PAYMENT_RATE_LIMIT_MAX=40
EARLY_ACCESS_RATE_LIMIT_MAX=10

# Greater Anglia execution remains safety locked for release verification.
GREATER_ANGLIA_PLAYWRIGHT_EXECUTOR_ENABLED=false
GREATER_ANGLIA_FINAL_SUBMIT_ENABLED=false
GREATER_ANGLIA_CANCELLATION_FINAL_SUBMIT_ENABLED=false
